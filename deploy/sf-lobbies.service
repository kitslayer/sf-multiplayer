[Unit]
Description=Stick Fight lobby control plane (list / create / stop + reaper)
Documentation=https://github.com/kitslayer/sf-multiplayer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miles
Group=miles
WorkingDirectory=/home/miles/sf-multiplayer

# Secret token for create/stop (POST). Lives outside git; '-' = optional so a
# fresh checkout without the file still starts (create just stays token-gated).
EnvironmentFile=-/home/miles/sf-oracle/sf-control.env
Environment=SF_LOBBIES_DIR=/tmp/sf-lobbies
Environment=SF_MAX_LOBBIES=6
Environment=SF_ROUTER_STATS=http://127.0.0.1:8081/router/stats
# Unbuffer so reaper/create log lines reach the journal immediately.
Environment=PYTHONUNBUFFERED=1
# Empty-lobby reaper TTL. Default 300s reaps any 0-player lobby after 5 min —
# too aggressive when the server idles with no players (e.g. waiting for a
# test). 24h effectively keeps idle lobbies alive while still cleaning up
# DEAD-pid (crashed) lobbies every pass. Lower for a busy public server.
Environment=SF_LOBBY_EMPTY_TTL=86400

ExecStart=/usr/bin/python3 /home/miles/sf-multiplayer/serve-lobbies.py --host 0.0.0.0 --port 8080

# CRITICAL: this service SPAWNS lobby backends (launch-lobby.sh). KillMode=process
# kills only the python main process on stop/restart, leaving running lobbies
# alive — the control plane is just an API; lobbies outlive it.
KillMode=process
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
