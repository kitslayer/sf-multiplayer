[Unit]
Description=Stick Fight single-port UDP router (multi-lobby front door)
Documentation=https://github.com/kitslayer/sf-multiplayer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miles
Group=miles
# Public UDP front door on :1338 (firewall-open). Routes each client to the
# backend SF.exe for the lobby code it SELECTed, per the /tmp/sf-lobbies
# registry. Backends stay on loopback; only this port is exposed.
# -default MAIN: a client that never SELECTs (an old direct-connect client
# repointed here, or the patched-DLL game socket before its recon socket's
# SELECT lands) is routed to MAIN instead of dropped, so the router is safe to
# use as the single front door.
# SF_CONTROL_TOKEN for the CREATE/RESTART proxy (-control → localhost serve-lobbies).
# Same token file serve-lobbies uses; optional (- prefix) so the router still runs
# without it (create/restart just return 403 then).
EnvironmentFile=-%h/sf-oracle/sf-control.env
# -default MAIN: no-SELECT clients + the patched-DLL game socket route to MAIN.
# CREATE/RESTART control ops proxy to -control (default http://127.0.0.1:8080).
ExecStart=%h/sf-router -listen 0.0.0.0:1338 -registry /tmp/sf-lobbies -stats 127.0.0.1:8081 -default MAIN
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
